+    /** 全程使用隔离 schema 和签名测试替身，不向任何 RPC 广播。 */
+    @Test void merchantPayoutProjectionKeepsOriginalChainIdentityAndExcludesSecrets(){
+        enableCustody();fund("PAYOUT_PRINCIPAL","100");fund("SERVICE_FEE","10");var op=createPayout("projection");
+        String id=op.get("operation_id").toString(),payoutId=op.get("payout_id").toString();
+        var pending=projectedPayout(payoutId);
+        assertEquals("QUEUED",pending.get("status"));assertNull(pending.get("tx_hash"));assertNull(pending.get("sender_address"));
+        assertEquals("AWAITING_APPROVAL",pending.get("custody_status"));assertFalse((Boolean)pending.get("safe_to_release_user_principal"));
+        custody.approve(id,1,"test-admin");assertNotNull(custody.claimReady(id,"projection-worker"));
+        String hash=UUID.randomUUID().toString().replace("-","").repeat(2);
+        var signed=new CustodyChainService.Prepared(new ChainModels.Signed(hash,"projection-signature-must-stay-private","TRON_PROTOBUF"),null,new BigDecimal("0.5"),Instant.now().plusSeconds(3600),map("private_detail","not-public"));
+        custody.persistPrepared(id,"projection-worker",signed);custody.beginBroadcast(id,"projection-worker");
+        custody.broadcastResult(id,"projection-worker",false,null,"RPC_TIMEOUT");
+        var uncertain=projectedPayout(payoutId);
+        assertEquals("UNKNOWN",uncertain.get("status"));assertEquals("UNKNOWN",uncertain.get("chain_status"));assertEquals(hash,uncertain.get("tx_hash"));
+        assertFalse((Boolean)uncertain.get("safe_to_release_user_principal"));
+        String sender=db.one("SELECT address FROM wallets WHERE wallet_id=#{p.id}",map("id",op.get("source_wallet_id"))).get("address").toString();
+        assertEquals(sender,uncertain.get("sender_address"));assertEquals(TronAddress.fromHex("22".repeat(20)),uncertain.get("receiver_address"));
+        // 重播沿用原签名；返回的 Hash 与发送地址不随操作重试改变。
+        var current=custody.find(id);custody.retry(id,((Number)current.get("version")).longValue(),"test-admin");
+        custody.beginBroadcast(id,"projection-retry");custody.broadcastResult(id,"projection-retry",true,hash,null);
+        assertEquals(hash,projectedPayout(payoutId).get("tx_hash"));assertEquals(sender,projectedPayout(payoutId).get("sender_address"));
+        custody.reconcile(id,new CustodyChainService.Settlement("CONFIRMED",100,true,new BigDecimal("0.000123"),"projection-final-block"));
+        var completed=projectedPayout(payoutId);
+        assertEquals("SUCCEEDED",completed.get("status"));assertEquals("CONFIRMED",completed.get("chain_status"));assertEquals("SUCCEEDED",completed.get("custody_status"));
+        assertEquals("USDT_TRON",completed.get("fee_asset_id"));assertEquals("TRX_TRON",completed.get("network_fee_asset_id"));
+        assertEquals(0,new BigDecimal("3").compareTo(Amounts.value(completed.get("max_fee_charge"))));
+        assertEquals(0,new BigDecimal("0.000123").compareTo(Amounts.value(completed.get("actual_fee_native"))));
+        for(var row:List.of(pending,uncertain,completed)){
+            for(String key:List.of("id","wallet_id","source_wallet_id","signed_payload","signed_format","details","key_ref","key_ciphertext","raw_transaction_ref","request_fingerprint","worker_id","lease_until","principal_account_id","fee_account_id"))assertFalse(row.containsKey(key),key);
+            assertFalse(row.containsKey("current_confirmations"),"确认数没有持久化来源，不能编造");
+        }
+    }
